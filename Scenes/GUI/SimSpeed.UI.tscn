[sub_resource type="GDScript" id="GDScript_60git"]
script/source = "extends MarginContainer

@onready var normal: Button = $Control/Normal
@onready var control: HBoxContainer = $Control

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	for each : BaseButton in control.get_children():
		each.toggled.connect(onChange)

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	pass

func onChange(_on: bool):
	var thisButton = normal.button_group.get_pressed_button()
	for button in control.get_children():
		if button == thisButton: 
			var rate = button.get_meta(\"Speed\")
			G.setGameSpeed(rate)
			button.modulate = button.get_meta(\"Color\")
		else: 
			button.modulate = Color.WHITE
		
"

