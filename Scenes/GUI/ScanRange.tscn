expression = "bool x = input0.x < 8. && input0.x > -8.;
bool y = input0.y < 8. && input0.y > -8.;

bool X = ! ( input0.x > 50. || input0.x < -50. );
bool Y = ! ( input0.y > 50. || input0.y < -50. );

bool comp1 = x || y;
bool comp2 = X && Y;
output0 = comp1 && comp2;"

