[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_hfqwf"]
size = Vector2(365, 360)
expression = "bool x = input0.x < 4. && input0.x > -4.;
bool y = input0.y < 4. && input0.y > -4.;

bool X = ! ( input0.x > 80. || input0.x < -80. );
bool Y = ! ( input0.y > 80. || input0.y < -80. );

bool Xi = ! ( input0.x > 30. || input0.x < -30. );
bool Yi = ! ( input0.y > 30. || input0.y < -30. );

bool comp1 = x || y;
bool comp2 = X && Y;
bool comp3 = Xi && Yi;
output0 = (comp1 && comp2) && ! comp3;"

