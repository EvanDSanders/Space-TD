[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_5ub37"]
size = Vector2(460, 939.99994)
expression = "A = 1.;
if (isB && IsMiner) {
	if (IsMinable)
		{ rangeC = vec4(0.05,1,.05,1); }
	else
		{ rangeC = vec4(2,.05,.05,1); }
}

C  = rangeA * rangeC;

if (isB) {
	if (!IsPlaceable) {
		spaceC = vec4(1, 0, 0, 1);
		if (IsPlaceableZone) {
			C += vec4(.6, .025, .025, 1);
		}
	}
	if (IsMiner && !IsMinable) {
		if (IsMinableZone) {
			C += vec4(.6, .1, .1, 1);
		}
	}
	C += linkA * linkC;
	C += spaceA * spaceC;
}
A = 5. * dot(C.rgb, vec3(0.299, 0.587, 0.114)); // luminance -> alpha"

