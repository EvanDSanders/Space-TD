[sub_resource type="GDScript" id="GDScript_eoje4"]
script/source = "extends Panel


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var Tw := create_tween()
	Tw.set_parallel()
	
	clip.custom_maximum_size.x = 0.01
	
	Tw.tween_property(clip, \"custom_maximum_size\", Vector2(5000., -1.), 0.5)
	
	$VBoxContainer2/SpacerB2/Menu.pressed.connect(Loader.MainMenu)
	$VBoxContainer2/SpacerB2/Restart.pressed.connect(Loader.Restart)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

@onready var clip: PanelContainer = $VBoxContainer/HBoxContainer/PanelContainer



func Expand():
	var Tw := create_tween()
	Tw.set_parallel()
	
	
	Tw.tween_property($\".\", \"self_modulate\", Color.BLACK, 1.5)
	Tw.tween_property($VBoxContainer/SpacerB, \"size_flags_stretch_ratio\", 1.0, 1.5).set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CUBIC)
	Tw.tween_property($VBoxContainer2/SpacerT, \"size_flags_stretch_ratio\", 2.0, 1.5).set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CUBIC)
"

