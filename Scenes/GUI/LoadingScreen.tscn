[sub_resource type="GDScript" id="GDScript_eoje4"]
script/source = "@tool
extends Control


var crystals : Dictionary

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	crystals = {
		1: $CrystalA,
		2: $CrystalB,
		3: $CrystalC,
		4: $CrystalD,
	}


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	for id in crystals:
		var crystal : Control = crystals[id]
		
		var t = Time.get_ticks_msec() / 1000.0 * 10
		var phase = sin(t + (PI/2*id))
		var altphase = cos(t + (PI/2*id))
		
		crystal.position.y = phase * 47.5 
		
		crystal.rotation_degrees = altphase * 15
		
		if altphase > 0: 
			crystal.z_index = 101
		else:  
			crystal.z_index = 99
"

