[sub_resource type="GDScript" id="GDScript_i6sge"]
script/source = "extends Button

var cost: int
var data: Dictionary
var dock: ShipConstructionDock

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	if G.StarStation:
		G.StarStation.crystal.CrystalsChange.connect(eval)

func eval(__=null):
	self.disabled = G.StarStation.crystal.Crystals < cost or dock.isFull()
"

