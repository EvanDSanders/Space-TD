[sub_resource type="GDScript" id="GDScript_ab6ls"]
resource_name = "Station Meter Part"
script/source = "extends Panel


var top : float
var bottom : float
var value : float


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.

const on  : Color = Color.WHITE
const off : Color = Color(0.1, 0.1, 0.1)

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	
	if value > top:
		self.modulate = off
	elif value < bottom:
		self.modulate = on
	else: 
		var val : float = ( Time.get_ticks_msec() % 5000 ) / 1000.
		var bound : float = G.remap(self.bottom, self.top, 0., 1., self.value)
		self.modulate = on if val > bound else off
		
		self.modulate = Color.from_hsv(0., 0., G.remap(bottom, top, 1.0, 0.1, value))
		
		#print( self.name, \" : \", G.remap(self.bottom, self.top, 0.1, 1.0, self.value) )
	

func update(value:float, max:float, segments:int): 
	self.value = G.remap( 
		0, max, segments, 0, value
	)
"

[sub_resource type="GDScript" id="GDScript_nlu5d"]
script/source = "extends HBoxContainer

@onready var constructor: ShipConstructionDock = $\"../ShipContructionDock\"


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var ships = TOML.parse_string(FileAccess.get_file_as_string(\"res://Scenes/StationShips/HangarConstructables.toml\"))
	for ship in ships:
		var button : Button = preload(\"res://Scenes/GUI/Station/ShipConstrucableButton.tscn\").instantiate()
		
		button.data = ships[ship]
		button.cost = ships[ship]['cost']
		button.tooltip_text = ships[ship]['name']
		button.dock = constructor
		
		self.add_child(button)
		
		button.pressed.connect( self.onPress.bind(button) )


func onPress(button):
	print( button.data )
	constructor.build(button.data)
	

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
"

