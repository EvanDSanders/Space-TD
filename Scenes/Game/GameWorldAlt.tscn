[sub_resource type="GDScript" id="GDScript_jruad"]
resource_name = "StationResources"
script/source = "@tool
extends MarginContainer

@onready var meters: HBoxContainer = $HBoxContainer/Meters
@onready var healthBar: VBoxContainer = $HBoxContainer/Meters/Health
@onready var energyBar: VBoxContainer = $HBoxContainer/Meters/Energy

@onready var panel: Panel = $\"../PartRefs/PartRefsList/Panel\"
@onready var spacer: Control = $\"../PartRefs/PartRefsList/Spacer\"

var segments : int = 200.0:
	set(s):
		segments = s
		onChange()

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	onChange()

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if Engine.is_editor_hint(): return
	G.StarStation.health.HPChange.emit( 
			G.StarStation.health.HP
		)


func onChange():
	if not is_node_ready(): return
	for meter in meters.get_children():
		#print(\"Working on \", meter.name)
		for each in meter.get_children():
			each.queue_free()
			
			
		#for x:int in range():
		for x:int in range(segments):
			var part : Control
			if x % 2 == 0:
				part = panel.duplicate()
				part.top = ( roundf(x / 2.) + 1 )
				part.bottom = ( roundf(x / 2.) )
				
				print(\"^: \", part.top, \" v: \", part.bottom, \" X: \", roundf(x / 2.), \" / S: \", segments / 2.)
				
				G.StarStation.health.HPChange.connect(
						func(v:float): part.value = G.remap( 
							0, G.StarStation.health.HPMax, segments / 2., 0, v
							#0, G.StarStation.health.HPMax, 0, segments / 2., v
						)
					)
			else:
				part = spacer.duplicate()
			#print(\"Adding \", part.name, \" to \", meter.name)
			meter.add_child(part)
			part.owner = meter
	
	var HIco = $\"../PartRefs/PartRefsList/HealthIco\".duplicate()
	var EIco = $\"../PartRefs/PartRefsList/EnergyIco\".duplicate()
	healthBar.add_child( HIco )
	energyBar.add_child( EIco )
	HIco.owner = healthBar
	EIco.owner = energyBar
	
"

