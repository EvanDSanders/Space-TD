[sub_resource type="GDScript" id="GDScript_eoje4"]
script/source = "extends Button



func _on_pressed() -> void:
	for shape : CollisionShape3D in G.Main.find_children(\"*\", \"CollisionShape3D\"):
		shape.debug_fill = true
		shape.debug_color.a = 0.3
"

