[sub_resource type="GDScript" id="GDScript_jruad"]
resource_name = "StationResources"
script/source = "extends MarginContainer

@onready var meters: HBoxContainer = $VBoxContainer/HBoxContainer/Meters
@onready var healthBar: VBoxContainer = $VBoxContainer/HBoxContainer/Meters/Health
@onready var energyBar: VBoxContainer = $VBoxContainer/HBoxContainer/Meters/Energy
@onready var crystalBar: VBoxContainer = $VBoxContainer/HBoxContainer/Meters/Crystal
@onready var crystals: Label = $VBoxContainer/Label

@onready var panel: Panel = $\"../PartRefs/PartRefsList/Panel\"
@onready var spacer: Control = $\"../PartRefs/PartRefsList/Spacer\"

var healthBarItems : Array[Panel]
var energyBarItems : Array[Panel]
var crystalBarItems : Array[Panel]

var segments : int = 200.0:
	set(s):
		segments = s
		onChange()

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	G.schedule.call_deferred(self.onChange, 1)
	G.StarStation.crystal.CrystalsChange.connect( func(c:int): crystals.text = str(c) )

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	return

func updateHealth(__:float=0):
	for each in healthBarItems:
		each.update(G.StarStation.health.HP, G.StarStation.health.HPMax, segments / 2.)

func updateEnergy(__:float=0):
	for each in energyBarItems:
		each.update(G.StarStation.energy.Energy, G.StarStation.energy.EnergyMax, segments / 2.)

var maxCrystals : int = 1000
func updateCrystals(__:float=0):
	if G.StarStation.crystal.Crystals > maxCrystals: maxCrystals = G.StarStation.crystal.Crystals
	for each in crystalBarItems:
		each.update(G.StarStation.crystal.Crystals, maxCrystals, segments / 2.)


func onChange():
	if not is_node_ready(): return
	print(\"Updating!\")
	for meter in meters.get_children():
		#print(\"Working on \", meter.name)
		for each in meter.get_children():
			each.queue_free()
			
			
		#for x:int in range():
		for x:int in range(segments):
			var part : Control
			if x % 2 == 0:
				part = panel.duplicate()
				part.top = ( roundf(x / 2.) + 1 )
				part.bottom = ( roundf(x / 2.) )
				
				#print(\"^: \", part.top, \" v: \", part.bottom, \" X: \", roundf(x / 2.), \" / S: \", segments / 2.)
				match meter.name:
					\"Health\":
						healthBarItems.append(part)
					\"Energy\":
						energyBarItems.append(part)
					\"Crystal\":
						crystalBarItems.append(part)
			else:
				part = spacer.duplicate()
			meter.add_child(part)
			part.owner = meter
	
	var HIco = $\"../PartRefs/PartRefsList/HealthIco\".duplicate()
	var EIco = $\"../PartRefs/PartRefsList/EnergyIco\".duplicate()
	var CIco = $\"../PartRefs/PartRefsList/CrystalIco\".duplicate()
	healthBar.add_child( HIco )
	energyBar.add_child( EIco )
	crystalBar.add_child( CIco )
	HIco.owner = healthBar
	EIco.owner = energyBar
	CIco.owner = crystalBar
	
"

