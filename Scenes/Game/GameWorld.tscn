[sub_resource type="GDScript" id="GDScript_0engo"]
script/source = "extends VBoxContainer


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.

@onready var StarShip: TheStarShip = $\"../Friendlies/The Star Ship\"

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass


func _on_fw_pressed() -> void:
	StarShip.fighter.FlightMode = StarShipFighter.FlightModes.Forward
	G.Camera.setFightStyle('Forward')
	G.Camera.onChange()

func _on_ss_pressed() -> void:
	StarShip.fighter.FlightMode = StarShipFighter.FlightModes.SideScroller
	G.Camera.setFightStyle('SideFire')
	G.Camera.onChange()

func _on_sf_pressed() -> void:
	StarShip.fighter.FlightMode = StarShipFighter.FlightModes.SideFire
	G.Camera.setFightStyle('SideFire')
	G.Camera.onChange()

func _on_td_pressed() -> void:
	StarShip.fighter.FlightMode = StarShipFighter.FlightModes.TopDown
	G.Camera.setFightStyle('TopDown')
	G.Camera.onChange()
"

