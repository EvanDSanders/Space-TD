[sub_resource type="GDScript" id="GDScript_wrj0t"]
script/source = "@tool
extends EditorScript



func _run() -> void:
	for each in get_scene().get_children():
		each.queue_free()
	var l = preload(\"res://Scenes/Friendlies/Asteroid.tscn\")

	var dist = 0
	for x in range(2, 21):
		var a : Node3D = l.instantiate()
		a._debugSize = x
		
		get_scene().add_child(a)
		
		a.position.x = dist
		a.owner = get_scene()
		
		dist += x*2.6
"

